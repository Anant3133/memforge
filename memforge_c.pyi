"""
Type stub definitions for the compiled C++ native extension `memforge_c`.
Provides type checking and IDE autocomplete support for MemForge's pybind11 module.
"""

from typing import List, Optional
from enum import Enum


class SequenceStatus(Enum):
    WAITING: int
    RUNNING: int
    SWAPPED: int
    FINISHED: int
    ABORTED: int


class SequenceStepInfo:
    seq_id: int
    block_table: List[int]
    prompt_length: int
    output_length: int
    total_length: int
    status: SequenceStatus
    is_prefill: bool

    def __init__(self) -> None: ...


class SchedulerStepResult:
    running_sequences: List[SequenceStepInfo]
    finished_sequence_ids: List[int]
    num_free_blocks: int
    total_blocks: int
    memory_utilization_ratio: float

    def __init__(self) -> None: ...


class EngineConfig:
    block_size: int
    num_gpu_blocks: int
    max_num_seqs: int
    max_model_len: int

    def __init__(self) -> None: ...


class Sequence:
    def __init__(
        self,
        id: int,
        prompt_tokens: List[int],
        max_new_tokens: int,
        block_size: int = 16,
    ) -> None: ...
    def get_id(self) -> int: ...
    def get_status(self) -> SequenceStatus: ...
    def set_status(self, status: SequenceStatus) -> None: ...
    def get_prompt_tokens(self) -> List[int]: ...
    def get_output_tokens(self) -> List[int]: ...
    def get_all_tokens(self) -> List[int]: ...
    def get_prompt_len(self) -> int: ...
    def get_output_len(self) -> int: ...
    def get_total_len(self) -> int: ...
    def get_block_table(self) -> List[int]: ...
    def append_token(self, token_id: int) -> None: ...
    def is_finished(self) -> bool: ...
    def finish(self) -> None: ...


class BlockAllocator:
    def __init__(self, total_blocks: int, block_size: int = 16) -> None: ...
    def can_allocate(self, num_blocks: int) -> bool: ...
    def allocate(self, seq: Sequence) -> bool: ...
    def allocate_blocks(self, num_blocks: int) -> List[int]: ...
    def free(self, seq: Sequence) -> None: ...
    def free_blocks(self, block_ids: List[int]) -> None: ...
    def get_num_free_blocks(self) -> int: ...
    def get_num_allocated_blocks(self) -> int: ...
    def get_total_blocks(self) -> int: ...
    def get_block_size(self) -> int: ...
    def get_utilization_ratio(self) -> float: ...
    def reset(self) -> None: ...


class Scheduler:
    def __init__(self, allocator: BlockAllocator, max_num_seqs: int = 256) -> None: ...
    def add_sequence(self, id: int, prompt_tokens: List[int], max_new_tokens: int) -> Sequence: ...
    def step(self) -> SchedulerStepResult: ...
    def update_sequence(self, seq_id: int, next_token: int) -> bool: ...
    def abort_sequence(self, seq_id: int) -> bool: ...
    def get_num_waiting(self) -> int: ...
    def get_num_running(self) -> int: ...
    def get_num_finished(self) -> int: ...
    def has_unfinished_sequences(self) -> bool: ...
    def get_sequence(self, seq_id: int) -> Optional[Sequence]: ...
