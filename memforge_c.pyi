"""
Type stub definitions for the compiled C++ native extension `memforge_c`.
Provides type checking and IDE autocomplete support for MemForge's pybind11 module.
"""

from typing import List, Optional, Tuple
from enum import Enum


class SequenceStatus(Enum):
    WAITING: int
    RUNNING: int
    SWAPPED: int
    FINISHED: int
    ABORTED: int


class SequenceStepInfo:
    seq_id: int
    block_table: List[int]
    prompt_length: int
    output_length: int
    total_length: int
    status: SequenceStatus
    is_prefill: bool
    #: Leading tokens whose KV is already resident via a prefix-cache hit, so the
    #: prefill must skip them and start here. 0 means "prefill everything".
    num_cached_tokens: int

    def __init__(self) -> None: ...


class SchedulerStepResult:
    running_sequences: List[SequenceStepInfo]
    finished_sequence_ids: List[int]
    #: Sequences evicted under memory pressure; their blocks were freed and they
    #: were re-queued, so the ML layer must recompute them from scratch.
    preempted_sequence_ids: List[int]
    #: Sequences that can never be scheduled (larger than the whole pool).
    aborted_sequence_ids: List[int]
    num_free_blocks: int
    total_blocks: int
    num_waiting: int
    memory_utilization_ratio: float

    def __init__(self) -> None: ...


class Sequence:
    def __init__(
        self,
        id: int,
        prompt_tokens: List[int],
        max_new_tokens: int,
        block_size: int = 16,
    ) -> None: ...
    def get_id(self) -> int: ...
    def get_status(self) -> SequenceStatus: ...
    def set_status(self, status: SequenceStatus) -> None: ...
    def get_prompt_tokens(self) -> List[int]: ...
    def get_output_tokens(self) -> List[int]: ...
    def get_all_tokens(self) -> List[int]: ...
    def get_prompt_len(self) -> int: ...
    def get_output_len(self) -> int: ...
    def get_total_len(self) -> int: ...
    def get_block_table(self) -> List[int]: ...
    def get_num_required_blocks(self) -> int: ...
    def has_completed_prefill(self) -> bool: ...
    #: Resets prefill state AND the cached-prefix count, for preempt-by-recompute.
    def reset_prefill(self) -> None: ...
    def get_num_cached_tokens(self) -> int: ...
    def set_num_cached_tokens(self, n: int) -> None: ...
    def append_token(self, token_id: int) -> None: ...
    def is_finished(self) -> bool: ...
    def finish(self) -> None: ...


class BlockAllocator:
    def __init__(self, total_blocks: int, block_size: int = 16) -> None: ...
    def can_allocate(self, num_blocks: int) -> bool: ...
    #: Allocates one block, returning its id (-1 when the pool is exhausted).
    def allocate(self) -> int: ...
    def allocate_blocks(self, num_blocks: int) -> List[int]: ...
    def free(self, block_id: int) -> None: ...
    def free_blocks(self, block_ids: List[int]) -> None: ...
    #: Frees a sequence's blocks and clears its table, returning the ids that
    #: actually reached ref_count 0 -- pass them to PrefixCache.evict().
    def free_sequence(self, seq: Sequence) -> List[int]: ...
    #: Grows the sequence's block table to cover its current length.
    #: Returns False when the pool cannot satisfy the growth.
    def ensure_capacity(self, seq: Sequence) -> bool: ...
    def get_num_free_blocks(self) -> int: ...
    def get_num_allocated_blocks(self) -> int: ...
    def get_total_blocks(self) -> int: ...
    def get_block_size(self) -> int: ...
    def get_utilization_ratio(self) -> float: ...
    def reset(self) -> None: ...

    # ------------------------------------------------------- prefix sharing

    #: Takes an extra reference on an allocated block, making it shared.
    #: False when the block is out of range or free -- which is what turns a
    #: stale PrefixCache entry into a clean miss instead of corrupted KV.
    def add_ref(self, block_id: int) -> bool: ...
    #: Frees blocks, returning ONLY those whose ref_count actually reached 0.
    #: Pass the result to PrefixCache.evict(); never evict from inside the
    #: allocator, which would invert the lock order and deadlock.
    def release(self, block_ids: List[int]) -> List[int]: ...
    #: Copy-on-write guard. Returns (old_block, new_block) when the logical block
    #: was shared and has been repointed at a private copy the caller must fill,
    #: or None when it was already private (the common case).
    def prepare_write(self, seq: Sequence, logical_index: int) -> Optional[Tuple[int, int]]: ...
    def get_ref_count(self, block_id: int) -> int: ...
    #: Allocated blocks carrying more than one reference.
    def get_num_shared_blocks(self) -> int: ...
    #: sum(ref_count) - count(allocated): block-allocations saved by sharing.
    def get_num_blocks_saved(self) -> int: ...


class Scheduler:
    #: `prefix_cache=None` keeps the pre-prefix-sharing behaviour: every block is
    #: allocated fresh. Passing a cache makes identical prompt prefixes share
    #: physical blocks.
    def __init__(
        self,
        allocator: BlockAllocator,
        max_num_seqs: int = 256,
        prefix_cache: Optional[PrefixCache] = None,
    ) -> None: ...
    def add_sequence(self, id: int, prompt_tokens: List[int], max_new_tokens: int) -> Sequence: ...
    def step(self) -> SchedulerStepResult: ...
    def update_sequence(self, seq_id: int, new_token: int, is_finished: bool) -> None: ...
    def abort_sequence(self, seq_id: int) -> bool: ...
    def get_num_waiting(self) -> int: ...
    def get_num_running(self) -> int: ...
    def has_unfinished_sequences(self) -> bool: ...
    def get_sequence(self, seq_id: int) -> Optional[Sequence]: ...
    def get_allocator(self) -> BlockAllocator: ...
    def get_prefix_cache(self) -> Optional[PrefixCache]: ...
    def prefix_sharing_enabled(self) -> bool: ...


class PrefixCache:
    """Registry mapping chained prefix hashes to shareable physical blocks.

    Only full blocks are shareable, and a prompt's trailing block always stays
    private -- which is what keeps the decode path copy-on-write-free.

    Lock order is PrefixCache -> BlockAllocator, never the reverse.
    """

    def __init__(self, allocator: BlockAllocator, block_size: int = 16) -> None: ...
    #: Longest cached prefix of `tokens`, with a reference taken on each block.
    #: The caller owns those references: install them in a sequence's block table
    #: or hand them back via release_acquired(), or they leak permanently.
    def acquire_shared_prefix(self, tokens: List[int]) -> List[int]: ...
    def release_acquired(self, block_ids: List[int]) -> None: ...
    #: Register a sequence's full blocks once their KV is actually written.
    #: Returns the number of newly registered blocks.
    def register_full_blocks(self, tokens: List[int], block_table: List[int]) -> int: ...
    #: Drop entries for blocks that returned to the free list. Fed from
    #: BlockAllocator.release(); without it a recycled block could be served for
    #: stale content.
    def evict(self, released: List[int]) -> None: ...
    def clear(self) -> None: ...
    def num_cached_blocks(self) -> int: ...
    def num_hits(self) -> int: ...
    def num_misses(self) -> int: ...
    def hit_rate(self) -> float: ...
    def get_block_size(self) -> int: ...


#: Chained prefix hash of one token block. `parent_hash` is the preceding block's
#: hash (0 for the first block). The chaining is load-bearing: a block's KV
#: depends on every token before it, so hashing a block in isolation would match
#: sequences that share a fragment but diverge earlier. Never returns 0.
def hash_block(parent_hash: int, tokens: List[int]) -> int: ...
